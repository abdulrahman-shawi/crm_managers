generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  image     String?
  role      Role       @default(USER)
  isActive  Boolean    @default(true)
  lastLogin DateTime?  @db.Timestamp(6)
  createdAt DateTime   @default(now()) @db.Timestamp(6)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamp(6)
  Category  Category[]
  Invoice   Invoice[]
  Product   Product[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  color       String?
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  userId      Int?
  User        User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    Product[]
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?   @unique
  phone     String?
  address   String?
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  invoices  Invoice[]
}

model Product {
  id           Int           @id @default(autoincrement())
  name         String
  price        Float
  priceLow     Float
  stock        Int           @default(0)
  categoryId   Int?
  image        String?
  createdAt    DateTime      @default(now()) @db.Timestamp(6)
  modelNumber  String?       @db.VarChar(255)
  userId       Int?
  status       String?       @db.VarChar(20)
  invoiceItems InvoiceItem[]
  User         User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category     Category?     @relation(fields: [categoryId], references: [id], onUpdate: NoAction, map: "fk_category")
}

model Testimonial {
  id     Int     @id @default(autoincrement())
  name   String
  role   String?
  text   String
  rating Int?
}

model Invoice {
  id          String        @id @default(cuid())
  type        InvoiceType   @default(REVENUE)
  status      InvoiceStatus @default(PENDING)
  totalAmount Float
  date        DateTime      @default(now()) @db.Timestamp(6)
  customerId  Int?
  createdAt   DateTime      @default(now()) @db.Timestamp(6)
  userId      Int?
  User        User?         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer    Customer?     @relation(fields: [customerId], references: [id], onUpdate: NoAction, map: "fk_customer")
  items       InvoiceItem[]
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId String
  productId Int
  quantity  Int     @default(1)
  unitPrice Float
  discount  Float   @default(0)
  note      String?
  subTotal  Float
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invoice")
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product")
}

model FixedExpense {
  id        Int      @id @default(autoincrement())
  name      String
  amount    Float
  dueDate   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model PageSeo {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  slug        String   @unique
  title       String
  description String
  keywords    String?
  ogImage     String?
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
}

model GeneralSettings {
  id               Int      @id @default(1)
  siteName         String   @default("متجري")
  currency         String   @default("EUR")
  contactEmail     String?
  facebookUrl      String?
  instagramUrl     String?
  updatedAt        DateTime @default(now()) @db.Timestamp(6)
  logoUrl          String?
  selectedTemplate String   @default("modern")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum InvoiceType {
  REVENUE
  EXPENSE
}

enum InvoiceStatus {
  PAID
  PENDING
}
