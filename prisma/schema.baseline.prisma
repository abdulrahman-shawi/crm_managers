generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  image     String?
  role      Role       @default(USER)
  isActive  Boolean    @default(true)
  lastLogin DateTime?  @db.Timestamp(6)
  createdAt DateTime   @default(now()) @db.Timestamp(6)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamp(6)
  Category  Category[]
  Invoice   Invoice[]
  Product   Product[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  color       String?
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  userId      Int?
  User        User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    Product[]
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?   @unique
  phone     String?
  address   String?
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  invoices  Invoice[]
}

model Product {
  id                 Int           @id @default(autoincrement())
  name               String
  price              Float
  priceLow           Float
  stock              Int           @default(0)
  categoryId         Int?
  image              String?
  createdAt          DateTime      @default(now()) @db.Timestamp(6)
  modelNumber        String?       @db.VarChar(255)
  userId             Int?
  status             String?       @db.VarChar(20)
  invoiceItems       InvoiceItem[]
  User               User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category           Category?     @relation(fields: [categoryId], references: [id], onUpdate: NoAction, map: "fk_category")
  returnsAsExchanged Return[]      @relation("ExchangedProduct")
  returnsAsReturned  Return[]      @relation("ReturnedProduct")
}

model Testimonial {
  id     Int     @id @default(autoincrement())
  name   String
  role   String?
  text   String
  rating Int?
}

model Invoice {
  id          String        @id @default(cuid())
  type        InvoiceType   @default(REVENUE)
  status      InvoiceStatus @default(PENDING)
  totalAmount Float
  date        DateTime      @default(now()) @db.Timestamp(6)
  customerId  Int?
  createdAt   DateTime      @default(now()) @db.Timestamp(6)
  userId      Int?
  User        User?         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer    Customer?     @relation(fields: [customerId], references: [id], onUpdate: NoAction, map: "fk_customer")
  items       InvoiceItem[]
  returns     Return[]
}

model Return {
  id                 String     @id @default(cuid())
  type               ReturnType
  quantity           Int        @default(1)
  priceDifference    Float      @default(0)
  note               String?
  invoiceId          String?
  returnedProductId  Int
  exchangedProductId Int?
  createdAt          DateTime   @default(now()) @db.Timestamp(6)
  exchangedQuantity  Int?
  exchangedProduct   Product?   @relation("ExchangedProduct", fields: [exchangedProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice            Invoice?   @relation(fields: [invoiceId], references: [id], onUpdate: NoAction)
  returnedProduct    Product    @relation("ReturnedProduct", fields: [returnedProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exchangedProductId])
  @@index([invoiceId])
  @@index([returnedProductId])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId String
  productId Int
  quantity  Int     @default(1)
  unitPrice Float
  discount  Float   @default(0)
  note      String?
  subTotal  Float
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invoice")
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product")
}

model FixedExpense {
  id        Int      @id @default(autoincrement())
  name      String
  amount    Float
  dueDate   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model PageSeo {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  slug        String   @unique
  title       String
  description String
  keywords    String?
  ogImage     String?
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
}

model GeneralSettings {
  id               Int      @id @default(1)
  siteName         String   @default("متجري")
  currency         String   @default("EUR")
  contactEmail     String?
  facebookUrl      String?
  instagramUrl     String?
  updatedAt        DateTime @default(now()) @db.Timestamp(6)
  logoUrl          String?
  selectedTemplate String   @default("modern")
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String @default("")
  channel       String
  version       String
  type          String
  blob          Bytes?

  @@id([thread_id, checkpoint_ns, channel, version])
}

model checkpoint_migrations {
  v Int @id
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String  @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  type          String?
  blob          Bytes

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String  @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  checkpoint           Json
  metadata             Json    @default("{}")

  @@id([thread_id, checkpoint_ns, checkpoint_id])
}

model n8n_chat_histories {
  id         Int    @id @default(autoincrement())
  session_id String @db.VarChar(255)
  message    Json
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum InvoiceType {
  REVENUE
  EXPENSE
}

enum InvoiceStatus {
  PAID
  PENDING
}

enum ReturnType {
  REFUND
  EXCHANGE
}


